# ===== Application Base URL (for links in emails) =====
# Used to generate the "Buka Dashboard" link in email reports.
APP_BASE_URL=https://your-project.vercel.app

# ===== SMTP (Gmail) for daily email reports =====
# Use Gmail SMTP with App Password (enable 2FA, create App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_account@gmail.com
SMTP_PASS=your_app_password_16_chars

# Sender and recipients (comma-separated)
EMAIL_FROM=your_gmail_account@gmail.com
EMAIL_TO=recipient1@example.com, recipient2@example.com

# Cron route secret (to manually trigger securely)
CRON_SECRET=change_me_to_a_strong_random_string

# Optional: limit email report to a specific warehouse ID
# REPORT_WAREHOUSE_ID=WH-001

# ===== DeepSeek (Optional, for AI insights) =====
# If you don't want AI insights, you can omit these.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== (Optional) Public base API (not strictly required) =====
NEXT_PUBLIC_BASE_API_URL=https://serverless-twg8.vercel.app
